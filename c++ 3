
3. RETAIL CHAIN MANAGEMENT SYSTEM
#include <iostream>
using namespace std;

class Product
{
private:
    string name;
    float price;
    int quantity;

public:
    void input()
    {
        cin>>name>>price>>quantity;
    }

    float sales()
    {
        return price*quantity;
    }

    string getName()
    {
        return name;
    }
};

class Store
{
private:
    int n;

public:
    Product p[100];
    static float overallSales;

    void input()
    {
        cin>>n;

        for(int i=0;i<n;i++)
            p[i].input();
    }

    float calculateStoreSales()
    {
        float total=0;

        for(int i=0;i<n;i++)
            total+=p[i].sales();

        overallSales+=total;

        return total;
    }
};

float Store::overallSales=0;

int main()
{
    int stores;
    cin>>stores;

    Store s[20];

    float bestSales=0;
    int bestStore=0;

    for(int i=0;i<stores;i++)
    {
        s[i].input();

        float total=s[i].calculateStoreSales();

        if(total>bestSales)
        {
            bestSales=total;
            bestStore=i;
        }
    }

    cout<<"Best Store = "<<bestStore+1<<endl;
    cout<<"Overall Sales = "<<Store::overallSales;
}
